{
  "name": "probeboard-api",
  "version": "0.1.0",
  "private": true,
  "description": "probeboard API and probe worker",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r src/core/db/migrations dist/core/db/migrations",
    "start:api": "node dist/api/main.js",
    "start:worker": "node dist/worker/main.js",
    "dev:api": "tsx watch --env-file-if-exists=.env src/api/main.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker/main.ts",
    "migrate": "tsx --env-file-if-exists=.env src/core/db/migrate.ts up",
    "migrate:down": "tsx --env-file-if-exists=.env src/core/db/migrate.ts down",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "kysely": "^0.29.5",
    "nestjs-pino": "^5.1.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "multer": "^2.3.0"
  }
}
